@article{wu2023ilc,
  abbr      = {Mucosal Imm.},
  title     = {Dynamic Regulation of Innate Lymphoid Cell Development During Ontogeny},
  author    = {Wu, Tao* and Chen, Sijie* and Zhu, Xinyi* and Ma, Jie* and Luo, Maocai and Wang, Yuanhao and Tian, Yujie and others and Zhang, Xuegong and Zhu, Yunping and Wu, Li},
  journal   = mucimm,
  volume    = {17},
  number    = {6},
  pages     = {1285--1300},
  year      = {2024},
  url       = {https://doi.org/10.1016/j.mucimm.2024.08.009},
  html      = {https://doi.org/10.1016/j.mucimm.2024.08.009},
  abstract  = {Lymphoid tissue inducer (LTi) cells dominate the fetal innate lymphoid cell (ILC) pool and decline after birth, while non-LTi ILCs increase. Fetal ILC progenitors preferentially differentiate into LTi cells, whereas postnatal bone marrow progenitors favor non-LTi ILCs, and this shift occurs within the first week after birth in mice. Adult ILC progenitors show stronger Notch signaling than fetal ones, with higher Gata3 and lower Rorc expression, which drives the transition from a fetal LTi-dominant to an adult non-LTi-dominant state. The body can thus tune ILC development through the level of Notch signaling to meet the different demands of each developmental stage.}
}

