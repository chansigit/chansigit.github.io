---
import { projects } from "../lib/content.js";
const { pubs } = Astro.props;
// paper key -> project page that discusses it
const projectOf = {};
for (const pr of projects)
  for (const k of String(pr.related_publications ?? "").split(/[\s,]+/).filter(Boolean))
    projectOf[k] ??= pr;
const here = Astro.url.pathname;
---

<ol class="pubs">
  {
    pubs.map((p) => (
      <li id={p.key}>
        {p.url ? (
          <a class="pub-title" href={p.url}>{p.title}</a>
        ) : (
          <span class="pub-title">{p.title}</span>
        )}
        <div class="pub-authors">
          {p.authors.map((a, i) => (
            <>
              {i > 0 && ", "}
              <span class={a.me ? "me" : undefined}>{a.name}</span>
            </>
          ))}
        </div>
        <div class="pub-venue">
          <span class="venue">{p.venue}</span>
          {`, ${p.year}`}
          {p.note && <span class="note"> ({p.note})</span>}
        </div>
        {projectOf[p.key] && !here.startsWith(`/projects/${projectOf[p.key].slug}`) && (
          <div class="pub-project"><a href={`/projects/${projectOf[p.key].slug}/`}>Project page: {projectOf[p.key].title}</a></div>
        )}
        {p.abstract && (
          <details>
            <summary>Abstract</summary>
            <p>{p.abstract}</p>
          </details>
        )}
      </li>
    ))
  }
</ol>
