---
import Base from "../../layouts/Base.astro";
import { posts } from "../../lib/content.js";
import { formatDate } from "../../lib/site.js";
---

<Base title="Blog">
  <div class="wrap">
    <header class="page-head">
      <h1>Blog</h1>
    </header>
    <ul class="dated">
      {
        posts.map((p) => (
          <li>
            <time datetime={p.date}>{formatDate(p.date)}</time>
            <a href={`/blog/${p.slug}/`}>{p.title}</a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
