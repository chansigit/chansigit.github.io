---
import Base from "../../layouts/Base.astro";
import PubList from "../../components/PubList.astro";
import { projects } from "../../lib/content.js";
import { publications } from "../../lib/bib.js";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const related = publications.filter((p) => p.key === project.related_publications);
---

<Base title={project.title} description={project.description}>
  <div class="wrap">
    <header class="page-head">
      <p><a href="/projects/">All projects</a></p>
      <h1>{project.title}</h1>
      <p class="lead">{project.description}</p>
    </header>
    <div class="prose"><project.Content /></div>
    {
      related.length > 0 && (
        <section class="block">
          <h2>Related publication</h2>
          <PubList pubs={related} />
        </section>
      )
    }
  </div>
</Base>
