---
import Base from "../../layouts/Base.astro";
import { projects } from "../../lib/content.js";

const categories = ["research", "infrastructure"];
---

<Base title="Projects" description="Selected projects on representation learning, generative modeling, and biological data integration.">
  <div class="wrap">
    <header class="page-head">
      <h1>Projects</h1>
      <p class="lead">Selected projects on representation learning, generative modeling, and biological data integration.</p>
    </header>
    {
      categories.map((c) => (
        <section class="project-group">
          <h2>{c}</h2>
          <ul class="project-list">
            {projects
              .filter((p) => p.category === c)
              .map((p) => (
                <li>
                  <a class="name" href={`/projects/${p.slug}/`}>{p.title}</a>
                  <p>{p.description}</p>
                </li>
              ))}
          </ul>
        </section>
      ))
    }
  </div>
</Base>
