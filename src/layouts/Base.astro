---
import "../styles/global.css";
import { site } from "../lib/site.js";

const { title, description = site.description } = Astro.props;
const path = Astro.url.pathname;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const isCurrent = (href) => (href === "/" ? path === "/" : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/cv/fonts/cmu-serif-500-roman.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <nav class="site-nav" aria-label="Main">
      <a class="brand" href="/">{site.name}</a>
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                {item.title}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <main>
      <slot />
    </main>
    <footer>&copy; {new Date().getFullYear()} {site.name}. Last updated {new Date().toISOString().slice(0, 10)}.</footer>
  </body>
</html>
